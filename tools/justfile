# DELETE every S3 object under DATA_PATH not referenced by the attached
# catalog. Renamed from `orphans`: the noun name read as a listing (the
# listing recipe is find-orphans, which shows a different thing — queue
# rows with missing S3 keys) and was one tab-complete from running the
# single most destructive recipe in this file. With a stale
# DUCKLAKE_DATA_PATH this deletes ANOTHER lake's live data.
# NOTE: cron logs and pushgateway metrics still label this
# operation=orphans — that is the python SUBCOMMAND name, which did not
# change; only this recipe name did.
[doc("DELETE every S3 object under DATA_PATH not referenced by the catalog (python subcommand: orphans)")]
[group('lifecycle')]
delete-orphaned-files: _confirm-target
    python {{ ducklake_maintenance }} orphans

